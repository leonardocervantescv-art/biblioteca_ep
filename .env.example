# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_ep

# Servidor web
PORT=3000

# JWT — OBLIGATORIO, no tiene valor por defecto. Usa una cadena larga y
# aleatoria propia; no reutilices la de otro entorno.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Cuenta de administrador — OBLIGATORIAS, se usan sólo la primera vez que
# arranca el servidor (si la tabla `usuarios` está vacía) para crear la cuenta
# con la que iniciar sesión.
ADMIN_NOMBRE=Responsable de Biblioteca
ADMIN_EMAIL=admin@universidadep.mx
ADMIN_PASSWORD=Admin123
