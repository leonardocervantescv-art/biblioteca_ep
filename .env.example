# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# ".env" NUNCA debe subirse al repositorio (ya está en .gitignore).

# ---------------------------------------------------------------------------
# Base de datos MySQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_ep

# ---------------------------------------------------------------------------
# Servidor web
# ---------------------------------------------------------------------------
# Puerto en el que escucha la aplicación.
PORT=3000
# Interfaz de red en la que escucha. "0.0.0.0" = todas (recomendado en
# producción, así responde tanto en localhost como en la IP/dominio público
# del servidor). Cámbialo solo si necesitas restringirlo a una interfaz.
HOST=0.0.0.0
# "development" o "production". En producción, JWT_SECRET es obligatorio.
NODE_ENV=production
# URL pública completa (solo informativa, se muestra en el log de arranque).
# PUBLIC_URL=https://biblioteca.epdemexico.edu.mx
# Defínela si el servidor corre detrás de un proxy inverso (Nginx, Apache,
# IIS/ARR, balanceador de carga, etc.) con TLS/HTTPS terminado ahí.
# TRUST_PROXY=1
# Dominios permitidos para llamadas a la API desde otro origen, separados
# por coma. Déjalo vacío si el sitio y la API se sirven desde el mismo
# dominio (caso normal de este proyecto).
# CORS_ORIGIN=https://biblioteca.epdemexico.edu.mx

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Genera uno único y secreto para producción, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Cuenta de administrador — se crea SOLO la primera vez que arranca el
# servidor, si la tabla "usuarios" está vacía.
# ---------------------------------------------------------------------------
ADMIN_NOMBRE=Responsable de Biblioteca
ADMIN_EMAIL=admin@epdemexico.edu.mx
ADMIN_PASSWORD=
